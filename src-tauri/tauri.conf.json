{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orlablocks",
  "version": "0.0.18",
  "identifier": "com.orlablocks.controlpanel",
  "build": {
    "frontendDist": "../dist/control-panel",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:control-panel",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Orlablocks Control Panel",
        "width": 560,
        "height": 640,
        "minWidth": 500,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
