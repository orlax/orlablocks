{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Orlablocks",
  "version": "0.0.18",
  "identifier": "com.orlablocks.controlpanel",
  "build": {
    "frontendDist": "../dist/control-panel",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:control-panel",
    "beforeBuildCommand": "npm run build && ./scripts/stage-node.sh"
  },
  "app": {
    "windows": [
      {
        "title": "OrlaBlocks Control Panel",
        "width": 620,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist/server": "dist/server",
      "../dist/web": "dist/web",
      "binaries/node": "node"
    }
  }
}
